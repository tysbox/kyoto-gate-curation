---
/**
 * 共通レイアウト
 * - ロケール対応の <html lang>
 * - Tailwind v4 (global.css)
 * - 言語切替・ナビ・フッターを内包
 */
import '../styles/global.css';
// セルフホストWebフォント (指示書 P2-1)
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/zen-old-mincho/400.css';
import '@fontsource/zen-old-mincho/500.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { localeHtmlLang, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={localeHtmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231B1A1A'/%3E%3Ctext x='16' y='23' font-family='serif' font-size='20' fill='%23BFA566' text-anchor='middle'%3E%E7%84%A1%3C/text%3E%3C/svg%3E"
      type="image/svg+xml"
    />
  </head>
  <body
    class="bg-background font-body text-on-surface antialiased selection:bg-secondary-fixed washi-grain relative"
  >
    <Header lang={lang} />
    <main class="w-full pt-20 bg-background">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // スクロール連動リビール (元ポータブルHTMLと同等のフォールバック付き)
      (function initReveals() {
        const nodes = Array.from(document.querySelectorAll('.reveal-node'));
        if (!nodes.length) return;
        const reveal = (el: Element) => el.classList.add('is-revealed');
        const sweep = () => {
          const vh = window.innerHeight || document.documentElement.clientHeight;
          nodes.forEach((n) => {
            if (n.classList.contains('is-revealed')) return;
            const r = n.getBoundingClientRect();
            if (r.top < vh * 0.92 && r.bottom > 0) reveal(n);
          });
        };
        if ('IntersectionObserver' in window) {
          try {
            const observer = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    reveal(entry.target);
                    observer.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
            );
            nodes.forEach((node) => observer.observe(node));
          } catch {
            /* fall through to scroll fallback */
          }
        }
        window.addEventListener('scroll', sweep, { passive: true });
        window.addEventListener('resize', sweep, { passive: true });
        window.addEventListener('load', sweep);
        document.addEventListener('scrollend', sweep);
        // アンカージャンプ直後にも確実に発火させる
        sweep();
        setTimeout(sweep, 300);
        setTimeout(sweep, 1200);
        setTimeout(sweep, 2500);
      })();
    </script>
  </body>
</html>
