---
/**
 * Accreditation(パトロン登録・事前診立て)セクション
 * フォームはローカル完結(送信は確認表示のみ)。
 */
import { getUI, type Locale } from '../../i18n';
import type { TextSection, FormContent } from '../../types';

interface Props {
  lang: Locale;
  accreditation: TextSection & { form: FormContent };
}
const { lang, accreditation } = Astro.props;
const ui = getUI(lang);
const form = accreditation.form;
---

<section class="w-full bg-background py-[var(--section-y)] px-6 lg:px-16 relative" id="accreditation">
  <div class="max-w-container mx-auto">
    <div class="reveal-node text-center max-w-2xl mx-auto mb-16">
      <span class="font-sans text-[11px] uppercase tracking-[0.26em] text-[var(--gold-text)] font-normal">
        {accreditation.eyebrow}
      </span>
      <h2 class="font-display text-2xl md:text-4xl text-on-surface font-light mt-2 mb-space-sm">
        {accreditation.title}
      </h2>
      <p class="font-body text-[15px] text-on-surface-variant leading-[2]">
        {accreditation.body}
      </p>
    </div>

    <div class="max-w-2xl mx-auto">
      <!-- フォーム -->
      <form
        class="reveal-node space-y-10"
        id="accreditation-form"
        novalidate
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10">
          {
            form.fields
              .filter((f) => f.type !== 'textarea')
              .map((f) => (
                <div class="flex flex-col pb-2 input-underline">
                  <label
                    class="font-sans text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-1 min-h-[2.75rem]"
                    for={`field-${f.name}`}
                  >
                    {f.label}
                    {f.required && <span class="text-secondary"> *</span>}
                  </label>
                  <input
                    class="bg-transparent border-none outline-hidden font-body text-on-surface py-1 w-full"
                    id={`field-${f.name}`}
                    name={f.name}
                    type={f.type === 'email' ? 'email' : 'text'}
                    placeholder={f.placeholder}
                    required={f.required}
                  />
                </div>
              ))
          }
        </div>

        {
          form.fields
            .filter((f) => f.type === 'textarea')
            .map((f) => (
              <div class="flex flex-col pb-2 input-underline">
                <label
                  class="font-sans text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-1 min-h-[2.75rem]"
                  for={`field-${f.name}`}
                >
                  {f.label}
                  {f.required && <span class="text-secondary"> *</span>}
                </label>
                <textarea
                  class="bg-transparent border-none outline-hidden font-body text-on-surface py-1 w-full resize-y min-h-24"
                  id={`field-${f.name}`}
                  name={f.name}
                  rows="4"
                  placeholder={f.placeholder}
                  required={f.required}
                />
              </div>
            ))
        }

        <!-- プロトコル承諾 -->
        <div class="flex items-start gap-3">
          <button
            class="w-5 h-5 mt-0.5 shrink-0 bg-transparent border border-outline-variant flex items-center justify-center transition-all duration-300 hover:border-secondary"
            id="protocol-btn"
            type="button"
            aria-label={ui.form.protocolAccept}
          >
            <svg
              class="icon-inline text-primary text-[16px] opacity-0 transition-opacity"
              id="protocol-check"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9.6 16.2 5.4 12l-1.4 1.4 5.6 5.6L20.4 7.8 19 6.4z" />
            </svg>
          </button>
          <div class="flex flex-col gap-2">
            <p class="font-body text-xs text-on-surface-variant leading-relaxed">
              {form.protocolText}
            </p>
            <div
              class="h-px w-full bg-[var(--gold-line)] opacity-0 transition-opacity duration-500"
              id="protocol-warning"
              aria-hidden="true"
            >
            </div>
          </div>
        </div>

        <button
          class="w-full inline-flex items-center justify-center font-sans text-xs uppercase tracking-[0.18em] px-6 py-4 bg-primary text-on-primary hover:bg-primary/90 transition-all"
          type="submit"
        >
          {form.submitLabel}
        </button>
      </form>

      <!-- 送信完了 -->
      <div class="hidden" id="confirmation-view">
        <div class="text-center py-16">
          <svg
            class="icon-inline text-primary text-[32px] mx-auto mb-6 text-secondary"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.2-8 5-8-5V6l8 5 8-5z"
            />
          </svg>
          <h3 class="font-display text-2xl text-on-surface font-light mb-space-sm">
            {ui.form.success}
          </h3>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed max-w-md mx-auto mb-space-md">
            {ui.form.successDetail}
          </p>
          <button
            class="font-sans text-xs uppercase tracking-[0.18em] px-6 py-2.5 border border-outline-variant hover:border-secondary transition-colors"
            type="button"
            onclick="document.getElementById('confirmation-view')?.classList.add('hidden'); document.getElementById('accreditation-form')?.classList.remove('hidden');"
          >
            {ui.form.reset}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // プロトコル承諾トグル (指示書 P3-2: 未選択=細枠 / 選択=墨塗り+白チェック)
  const btn = document.getElementById('protocol-btn');
  const check = document.getElementById('protocol-check');
  const warning = document.getElementById('protocol-warning');
  const form = document.getElementById('accreditation-form') as HTMLFormElement | null;
  const confirmation = document.getElementById('confirmation-view');
  let accepted = false;

  if (btn && check) {
    btn.addEventListener('click', () => {
      accepted = !accepted;
      check.classList.toggle('opacity-0', !accepted);
      btn.classList.toggle('bg-primary', accepted);
      check.classList.toggle('text-white', accepted);
      // 同意したら警告線を消す
      if (accepted && warning) warning.style.opacity = '0';
    });
  }

  // 送信: 未同意なら金の細線を表示、同意済みならページ内確認表示へ (alert不使用)
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!accepted) {
      if (warning) warning.style.opacity = '1';
      btn?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    form.classList.add('hidden');
    confirmation?.classList.remove('hidden');
    confirmation?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
