---
/**
 * Manifesto(構想定理)セクション
 */
import { getUI, type Locale } from '../../i18n';
import type { TextSection } from '../../types';

interface Props {
  lang: Locale;
  manifesto: TextSection;
}
const { manifesto } = Astro.props;
const ui = getUI(Astro.props.lang);
---

<section class="w-full bg-background py-space-xl px-6 lg:px-16 relative" id="manifesto">
  <div class="max-w-container mx-auto">
    <div class="max-w-[1200px] mx-auto flex flex-col items-center text-center relative z-10">
      <div class="reveal-node inline-flex items-center gap-3 mb-space-md">
        <span class="font-sans text-xs uppercase tracking-[0.2em] text-secondary font-semibold">
          {manifesto.eyebrow}
        </span>
      </div>

      <h2
        class="reveal-node font-display text-2xl md:text-4xl text-on-surface font-light leading-snug mb-space-lg max-w-4xl"
      >
        {manifesto.title}
      </h2>

      {
        manifesto.quote && (
          <blockquote
            class="reveal-node font-display text-lg md:text-2xl text-on-surface italic max-w-4xl font-light leading-snug mb-space-lg"
          >
            {manifesto.quote}
          </blockquote>
        )
      }

      <p
        class="reveal-node font-body text-base md:text-lg text-on-surface-variant max-w-2xl font-light leading-relaxed mb-space-lg"
      >
        {manifesto.body}
      </p>

      {
        manifesto.metrics && manifesto.metrics.length > 0 && (
          <div
            class="reveal-node w-full max-w-3xl grid grid-cols-1 sm:grid-cols-3 gap-space-md pt-space-lg mt-space-md"
          >
            {manifesto.metrics.map((m) => (
              <div class="flex flex-col items-center p-space-md bg-surface-container-lowest gilded-frame">
                <span class="font-display text-3xl md:text-4xl text-primary font-light">
                  {m.value}
                  {m.unit && <span class="text-xl">{m.unit}</span>}
                </span>
                <span class="font-sans text-xs uppercase tracking-[0.2em] text-on-surface-variant mt-1 font-semibold">
                  {m.label}
                </span>
                <span class="text-[11px] text-secondary mt-1">{m.note}</span>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
