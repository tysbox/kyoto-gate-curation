---
/**
 * ホームページ本体
 * ロケール別コンテンツを読み込み、各セクションを描画する。
 */
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from './sections/HeroSection.astro';
import ManifestoSection from './sections/ManifestoSection.astro';
import PlateSection from './sections/PlateSection.astro';
import SanctuarySection from './sections/SanctuarySection.astro';
import AccreditationSection from './sections/AccreditationSection.astro';
import { loadPageData, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const data = loadPageData(lang);
---

{
  data ? (
    <MainLayout lang={lang} title={data.title} description={data.description}>
      <HeroSection lang={lang} hero={data.hero} />
      <ManifestoSection lang={lang} manifesto={data.manifesto} />

      <!-- Plate 01 / 02 (工芸・食) -->
      <section
        class="w-full bg-background py-[var(--section-y)] px-6 lg:px-16 relative"
        id="ateliers"
      >
        <div class="max-w-container mx-auto">
          <div class="flex items-center justify-between mb-space-lg border-b border-outline-variant/30 pb-4 reveal-node">
            <span class="font-sans text-[11px] uppercase tracking-[0.26em] text-[var(--gold-text)] font-normal">
              Living Ateliers
            </span>
            <span class="hidden sm:flex items-center gap-2 text-on-surface-variant font-sans text-[11px] tracking-[0.2em] uppercase font-normal">
              <span>REGISTER: 淺野鍛冶屋 / 表望堂 / 開化堂</span>
            </span>
          </div>

          <div class="space-y-[var(--section-y)]">
            {data.plates.map((plate, i) => (
              <PlateSection lang={lang} plate={plate} index={i} fullBleed={plate.id === 'gastronomy'} />
            ))}
          </div>
        </div>
      </section>

      <SanctuarySection lang={lang} sanctuaries={data.sanctuaries} />
      <AccreditationSection lang={lang} accreditation={data.accreditation} />
    </MainLayout>
  ) : (
    <MainLayout lang={lang} title="KYOTO GATEWAY" description="">
      <div class="py-space-xl px-6 text-center">
        <p class="font-body text-on-surface-variant">Content not found.</p>
      </div>
    </MainLayout>
  )
}
